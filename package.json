{
  "name": "olivia-energy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 115",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/check-node.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shots": "node scripts/screenshot.mjs",
    "a11y": "node scripts/lighthouse.mjs --categories=accessibility",
    "db:start": "supabase start -x studio,imgproxy,mailpit,edge-runtime,logflare,vector,supavisor,realtime,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema olivia_energy > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts",
    "db:test": "node scripts/rls-test.mjs --local",
    "db:hosted-sql": "node scripts/hosted-sql.mjs",
    "admin:create": "node scripts/create-admin.mjs --local",
    "lighthouse": "node scripts/lighthouse.mjs / /what-we-do --mobile-only"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.30.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "lighthouse": "^12.8.2",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
