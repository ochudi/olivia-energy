# Supabase (Project Settings -> API). The NEXT_PUBLIC_ pair is safe in the
# browser (RLS applies); the service-role key is server-only and bypasses RLS.
# Local stack: `npm run db:start` prints these, or `supabase status -o env`.
# Either key format works: the legacy anon / service_role JWTs, or the newer
# sb_publishable_… / sb_secret_… keys the CLI now prints.
# The data lives in its own schema (olivia_energy), which the project must
# list under Project Settings -> Data API -> Exposed schemas.
# Production values go in .env.hosted (git-ignored, not loaded by Next.js)
# and in the host's environment variables; never in a committed file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (contact-form delivery, admin invitations and password resets). The
# sender must be on a domain verified in Resend; contact messages go to
# settings.contact_email with Reply-To set to the sender. Empty: nothing is
# sent, messages wait in the admin inbox and an invitation shows its link.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Olivia Energy <no-reply@oliviaenergyandpower.com>"

# Cloudflare Turnstile (bot protection on the contact form and admin sign-in).
# The page passes the site key to the widget; the secret is only ever used
# server-side. The live site needs a real widget that lists its hostnames.
# Cloudflare's test keys, for local work and for testing the failure states:
#   always pass    site 1x00000000000000000000AA  secret 1x0000000000000000000000000000000AA
#   always block   site 2x00000000000000000000AB  secret 2x0000000000000000000000000000000AA
#   token spent    secret 3x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shared secret for POST /api/revalidate (Authorization: Bearer <secret>).
# Any long random string; e.g. `openssl rand -hex 32`.
REVALIDATE_SECRET=

# Public site URL (no trailing slash). Used for canonical URLs, the sitemap,
# social cards, structured data and emailed links. On Vercel leave it unset:
# the site uses the project's production domain. Elsewhere set it to the
# served origin, e.g. https://oliviaenergyandpower.com. Unset locally it is
# http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=
